# Copy to .env and adjust. Never commit real credentials.

# Wire in-memory adapters instead of real infrastructure (tests / offline dev).
CONTRACT_INTEL_USE_FAKES=true

# Postgres + pgvector (docker-compose service "postgres").
CONTRACT_INTEL_DATABASE__URL=postgresql+asyncpg://contract_intel:contract_intel@localhost:5432/contract_intel
CONTRACT_INTEL_DATABASE__POOL_SIZE=5

# S3-compatible object storage (docker-compose service "localstack").
CONTRACT_INTEL_STORAGE__BUCKET=contracts
CONTRACT_INTEL_STORAGE__ENDPOINT_URL=http://localhost:4566
CONTRACT_INTEL_STORAGE__REGION=us-east-1
# LocalStack accepts any credentials; leave unset to use the default AWS chain.
CONTRACT_INTEL_STORAGE__ACCESS_KEY_ID=test
CONTRACT_INTEL_STORAGE__SECRET_ACCESS_KEY=test

# Ingestion: local CUAD directory (scripts/download_cuad.py) and demo size.
CONTRACT_INTEL_INGESTION__CUAD_DIR=data/cuad/CUAD_v1/full_contract_pdf
CONTRACT_INTEL_INGESTION__MAX_DOCUMENTS=5

# LLM provider: Claude via the Anthropic SDK (RAG API answers).
# Leave the key empty to use the SDK's default credentials (ANTHROPIC_API_KEY, `ant auth login`).
CONTRACT_INTEL_LLM__API_KEY=replace-me
CONTRACT_INTEL_LLM__CHAT_MODEL=claude-sonnet-5-5
# Server-side fallback to another model when Claude declines a request.
CONTRACT_INTEL_LLM__FALLBACKS=false

# Embeddings (Voyage AI): https://dash.voyageai.com/ ; 50M free tokens for voyage-law-2.
CONTRACT_INTEL_EMBEDDINGS__API_KEY=replace-me
CONTRACT_INTEL_EMBEDDINGS__MODEL=voyage-law-2
CONTRACT_INTEL_EMBEDDINGS__DIMENSIONS=1024

# Chunking: size of the retrievable text windows (characters).
CONTRACT_INTEL_CHUNKING__MAX_CHARS=2000
CONTRACT_INTEL_CHUNKING__OVERLAP_CHARS=200

# Retrieval: chunks used as context for each question.
CONTRACT_INTEL_RETRIEVAL__TOP_K=8

# Clause extraction with Claude (reuses CONTRACT_INTEL_LLM__API_KEY).
CONTRACT_INTEL_EXTRACTION__MODEL=claude-sonnet-5-5
CONTRACT_INTEL_EXTRACTION__WINDOW_CHARS=24000

# Expert labels (CUAD) used to evaluate the extraction.
CONTRACT_INTEL_EVALUATION__LABELS_PATH=data/cuad/CUAD_v1/master_clauses.csv
