# Copy to .env and adjust. Never commit real credentials.

# Wire in-memory adapters instead of real infrastructure (tests / offline dev).
CONTRACT_INTEL_USE_FAKES=true

# Postgres + pgvector (docker-compose service "postgres").
CONTRACT_INTEL_DATABASE__URL=postgresql+asyncpg://contract_intel:contract_intel@localhost:5432/contract_intel
CONTRACT_INTEL_DATABASE__POOL_SIZE=5

# S3-compatible object storage (docker-compose service "localstack").
CONTRACT_INTEL_STORAGE__BUCKET=contracts
CONTRACT_INTEL_STORAGE__ENDPOINT_URL=http://localhost:4566
CONTRACT_INTEL_STORAGE__REGION=us-east-1

# LLM provider.
CONTRACT_INTEL_LLM__API_KEY=replace-me
CONTRACT_INTEL_LLM__CHAT_MODEL=gpt-4o-mini
CONTRACT_INTEL_LLM__EMBEDDING_MODEL=text-embedding-3-small
